{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es6",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "types": ["node"],
    "outDir": "./dist",
    "pretty": true,
    "removeComments": true,
    "rootDir": "./",
    "sourceMap": true,
    "strict": true
  },
  "exclude": ["node_modules", "dist"]
}
